{
  "name": "team-daily-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "面向团队主管的每日工作台：Outlook 邮件 AI 分类、钉钉日志/日程、每日/周报、待办、复盘、日历与项目时间线",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"node server/index.mjs\" \"vite\"",
    "server": "node server/index.mjs",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "electron:dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"node server/index.mjs\" \"vite\"",
    "electron:build": "vite build && electron-builder",
    "web:installer": "node scripts/build-web-installer.mjs",
    "test": "node --test server/"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.15.4",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "vite": "6.4.2"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.team.dailyworkbench",
    "productName": "团队每日工作台",
    "files": [
      "dist/client/**/*",
      "server/**/*",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    }
  }
}
