# 团队每日工作台（本机网页版）
# 本文件保存在安装目录 config\app.env；升级不会覆盖。

PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
CORS_ORIGIN=http://127.0.0.1:8787
USE_DEMO_DATA=false

# AI（按需填写）
AI_ROUTING_MODE=legacy
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Outlook（多租户公共客户端，无 Client Secret）
OUTLOOK_ENTRA_CLIENT_ID=
OUTLOOK_ENTRA_TENANT_ID=common
OUTLOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/outlook/oauth/callback
# 请在首次配置时生成 32 字节 Base64 密钥，配置后不要更换。
OUTLOOK_TOKEN_ENCRYPTION_KEY=

# 钉钉企业内部应用
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://127.0.0.1:8787/oauth/dingtalk/callback
DINGTALK_MANAGER_USER_ID=

AI_HOT_ORIGIN=https://aihot.virxact.com
