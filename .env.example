# ===== 服务基础 =====
# 后端监听地址
PORT=8787
# 前端访问地址（用于 OAuth 授权后回跳到前端页面，需与 Vite 实际监听一致）
# 注意：Vite dev 默认监听 localhost（IPv6 ::1），请用 localhost 而非 127.0.0.1
PUBLIC_BASE_URL=http://localhost:5174
# 允许跨域的前端源（dev 下前端用相对 /api 经代理访问，基本不触发 CORS）
CORS_ORIGIN=http://localhost:5174

# ===== AI 适配层（默认 DeepSeek，可切换）=====
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：OpenAI / Claude / 本地 Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://api.anthropic.com
# CLAUDE_MODEL=claude-sonnet-4
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b

# ===== Outlook / Microsoft Graph（多租户公共客户端，PKCE 无 secret）=====
# 变量名与 GitHub 仓库 WangYehen/my-work-bench 保持一致
# 在 Azure Entra 注册「任何组织目录中的帐户（多租户）」应用，无需 Client Secret
# 添加平台 "Mobile and desktop applications"，并注册下面这个重定向 URI（前端 5174 端口，经 Vite 代理转发至后端 8787 处理回跳）
# 所需权限范围：Mail.Read + offline_access
OUTLOOK_ENTRA_CLIENT_ID=
OUTLOOK_ENTRA_TENANT_ID=common
OUTLOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:5174/api/outlook/oauth/callback
# 32 字节 Base64 密钥，AES-256-GCM 加密本地 Outlook 状态与令牌；生成：openssl rand -base64 32
OUTLOOK_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ===== 钉钉（企业内部应用）=====
# 在钉钉开发者后台创建企业内部应用，并"正好"注册下面这个重定向 URI（前端 5174 端口，经 Vite 代理转发至后端 8787 处理回跳）
# 所需权限：日志(read)、日程(read)、通讯录成员(read)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://127.0.0.1:5174/oauth/dingtalk/callback
# 当前主管在钉钉的用户 ID（用于圈定下属与团队日志范围）
DINGTALK_MANAGER_USER_ID=

# ===== AI HOT 热点（公开匿名 API，无需密钥）=====
AI_HOT_ORIGIN=https://aihot.virxact.com

# ===== 演示数据兜底 =====
# 未配置任何外部服务时，是否用合成数据演示界面（true/false）
# 接入真实凭据后请改为 false，否则演示数据会与真实数据混合/覆盖
USE_DEMO_DATA=true
